PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=orchestrator_mvp
MASTER_STORAGE_DIR=storage/masters

# Admin access gate
ADMIN_ACCESS_ENABLED=true
ADMIN_ACCESS_TOKEN=
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_TTL_HOURS=12
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15

# Shopify webhook security
SHOPIFY_WEBHOOK_HMAC_REQUIRED=true
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_STORE_INVALID=true

# Configurator order safety
CONFIGURATOR_REQUIRED_SKU_PREFIXES=wandini-
CONFIGURATOR_MAX_OUTPUT_WIDTH_MM=20000
CONFIGURATOR_MAX_OUTPUT_HEIGHT_MM=5000
CONFIGURATOR_MAX_OUTPUT_AREA_M2=100

# External write controls
FTP_UPLOAD_ENABLED=false
SHOPIFY_WRITE_ENABLED=false

# Shopify Admin API executor (disabled and write-blocked by default)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_API_VERSION=2026-01
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WRITE_ORDER_ALLOWLIST=
SHOPIFY_FULFILLMENT_NOTIFY_CUSTOMER=false
SHOPIFY_UPDATE_EXECUTOR_ENABLED=false
SHOPIFY_UPDATE_TASK_BATCH_SIZE=5
SHOPIFY_UPDATE_TASK_MAX_ATTEMPTS=3

# Factory callback simulation/auth
FACTORY_CALLBACK_ENABLED=true
FACTORY_CALLBACK_AUTH_ENABLED=true
FACTORY_CALLBACK_API_KEY=

# NEXO callback adapter (disabled until migration 004 and a key are configured)
NEXO_CALLBACK_ENABLED=false
NEXO_CALLBACK_AUTH_ENABLED=true
NEXO_CALLBACK_API_KEY=
NEXO_PRODUCT_SKU=1.14-1.3.10

# Processing safety
PROCESSING_MIN_FREE_DISK_MB=1024
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_STALE_LOCK_MINUTES=30

# Artifact/tmp behavior for Phase 1
TMP_RETENTION_DAYS=7
ARTIFACT_RETENTION_DAYS=90

# Logging/security
LOG_REDACT_SECRETS=true
