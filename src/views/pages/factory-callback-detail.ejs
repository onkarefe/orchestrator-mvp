<section class="page">
  <header class="page-header">
    <div>
      <a class="back-link" href="/admin/factory-callbacks">Back to factory callbacks</a><p class="eyebrow">Factory Callback detail</p><h1>Factory Callback #<%= factoryCallback.id %></h1><p class="page-description"><%= admin.display(factoryCallback.provider) %></p>
    </div>
    <span class="status-badge <%= admin.statusClass(factoryCallback.processing_status) %>"><%= admin.statusLabel(factoryCallback.processing_status) %></span>
  </header>
  <section class="card">
    <div class="card-header">
      <h2>Factory notification</h2>
    </div>
    <dl class="meta-grid meta-grid-three">
      <div class="meta-item">
        <dt>Order</dt>
        <dd><% if (factoryCallback.order_id) { %><a href="/admin/orders/<%= factoryCallback.order_id %>">#<%= factoryCallback.order_id %></a><% } else { %>&mdash;<% } %></dd>
      </div>
      <div class="meta-item">
        <dt>Job</dt>
        <dd><% if (factoryCallback.job_id) { %><a href="/admin/jobs/<%= factoryCallback.job_id %>">#<%= factoryCallback.job_id %></a><% } else { %>&mdash;<% } %></dd>
      </div>
      <div class="meta-item">
        <dt>Factory reference</dt>
        <dd class="mono"><%= admin.display(factoryCallback.factory_reference) %></dd>
      </div>
      <div class="meta-item">
        <dt>Shopify order ID</dt>
        <dd class="mono"><%= admin.display(factoryCallback.shopify_order_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>Factory / NEXO identity</dt>
        <dd class="mono"><%= admin.display(factoryCallback.factory_order_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>Factory status</dt>
        <dd><span class="status-badge <%= admin.statusClass(factoryCallback.status) %>"><%= admin.statusLabel(factoryCallback.status) %></span></dd>
      </div>
      <div class="meta-item">
        <dt>Tracking count</dt>
        <dd><%= admin.display(factoryCallback.tracking_count) %></dd>
      </div>
      <div class="meta-item">
        <dt>Authentication</dt>
        <dd><span class="status-badge <%= admin.statusClass(admin.booleanLabel(factoryCallback.auth_valid)) %>"><%= admin.statusLabel(admin.booleanLabel(factoryCallback.auth_valid)) %></span></dd>
      </div>
      <div class="meta-item">
        <dt>Received</dt>
        <dd><%= admin.date(factoryCallback.received_at) %></dd>
      </div>
    </dl>
  </section>
  <section class="card">
    <div class="card-header">
      <h2>Delivery diagnostics</h2>
    </div>
    <dl class="meta-grid meta-grid-three">
      <div class="meta-item">
        <dt>Delivery ID</dt>
        <dd class="mono"><%= admin.display(factoryCallback.delivery_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>Duplicate of</dt>
        <dd class="mono"><%= admin.display(factoryCallback.duplicate_of_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>Error message</dt>
        <dd><%= admin.display(factoryCallback.error_message) %></dd>
      </div>
      <div class="meta-item">
        <dt>Created</dt>
        <dd><%= admin.date(factoryCallback.created_at) %></dd>
      </div>
    </dl>
  </section>
  <details class="card disclosure">
    <summary><strong>Redacted headers</strong></summary><pre class="code-panel"><%= admin.json(headersJson || {}) %></pre>
  </details>
  <details class="card disclosure">
    <summary><strong>Redacted payload</strong></summary><pre class="code-panel"><%= admin.json(rawPayloadJson || {}) %></pre>
  </details>
</section>
