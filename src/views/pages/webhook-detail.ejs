<section class="page">
  <header class="page-header">
    <div>
      <a class="back-link" href="/admin/webhooks">Back to webhooks</a><p class="eyebrow">Webhook detail</p><h1>Webhook #<%= webhook.id %></h1><p class="page-description"><%= admin.display(webhook.topic) %></p>
    </div>
    <span class="status-badge <%= admin.statusClass(webhook.processing_status) %>"><%= admin.statusLabel(webhook.processing_status) %></span>
  </header>
  <section class="card">
    <div class="card-header">
      <h2>Delivery summary</h2>
    </div>
    <dl class="meta-grid meta-grid-three">
      <div class="meta-item">
        <dt>Provider</dt>
        <dd><%= admin.display(webhook.provider) %></dd>
      </div>
      <div class="meta-item">
        <dt>Shopify order ID</dt>
        <dd class="mono"><%= admin.display(webhook.shopify_order_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>HMAC</dt>
        <dd><span class="status-badge <%= admin.statusClass(admin.booleanLabel(webhook.hmac_valid)) %>"><%= admin.statusLabel(admin.booleanLabel(webhook.hmac_valid)) %></span></dd>
      </div>
      <div class="meta-item">
        <dt>Delivery status</dt>
        <dd><span class="status-badge <%= admin.statusClass(webhook.status) %>"><%= admin.statusLabel(webhook.status) %></span></dd>
      </div>
      <div class="meta-item">
        <dt>Received</dt>
        <dd><%= admin.date(webhook.received_at) %></dd>
      </div>
      <div class="meta-item">
        <dt>Processed</dt>
        <dd><%= admin.date(webhook.processed_at) %></dd>
      </div>
    </dl>
  </section>
  <section class="card">
    <div class="card-header">
      <h2>Processing diagnostics</h2>
    </div>
    <dl class="meta-grid meta-grid-three">
      <div class="meta-item">
        <dt>Delivery ID</dt>
        <dd class="mono"><%= admin.display(webhook.delivery_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>Duplicate of</dt>
        <dd class="mono"><%= admin.display(webhook.duplicate_of_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>Attempt count</dt>
        <dd><%= admin.display(webhook.attempt_count) %></dd>
      </div>
      <div class="meta-item">
        <dt>Maximum attempts</dt>
        <dd><%= admin.display(webhook.max_attempts) %></dd>
      </div>
      <div class="meta-item">
        <dt>Locked by</dt>
        <dd class="mono"><%= admin.display(webhook.locked_by) %></dd>
      </div>
      <div class="meta-item">
        <dt>Locked at</dt>
        <dd><%= admin.date(webhook.locked_at) %></dd>
      </div>
      <div class="meta-item">
        <dt>Error message</dt>
        <dd><%= admin.display(webhook.error_message) %></dd>
      </div>
      <div class="meta-item">
        <dt>Created</dt>
        <dd><%= admin.date(webhook.created_at) %></dd>
      </div>
    </dl>
  </section>
  <details class="card disclosure">
    <summary><strong>Redacted headers</strong></summary><pre class="code-panel"><%= admin.json(headersJson || {}) %></pre>
  </details>
  <details class="card disclosure">
    <summary><strong>Redacted payload</strong></summary><pre class="code-panel"><%= admin.json(rawPayloadJson || {}) %></pre>
  </details>
</section>
