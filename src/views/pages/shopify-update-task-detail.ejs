<%
  const display = (value) =>
    value === null || value === undefined || value === '' ? '-' : value;
  const statusClass = (value) =>
    `status-${String(value || 'unknown').toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
  const dryRunLabel = (value) => value ? 'Dry-run' : 'Live';
%>
<section class="page">
  <header class="page-header page-header-with-actions">
    <div>
      <a class="back-link" href="/admin/shopify-update-tasks">Back to Shopify update tasks</a>
      <p class="eyebrow">Shopify update task detail</p>
      <h1>Shopify Update Task #<%= shopifyUpdateTask.id %></h1>
      <p class="page-description"><%= display(shopifyUpdateTask.task_type) %></p>
    </div>
    <span class="status-badge status-badge-large <%= statusClass(shopifyUpdateTask.status) %>">
      <%= display(shopifyUpdateTask.status) %>
    </span>
  </header>

  <section class="card">
    <div class="card-header">
      <div>
        <p class="section-label">Dry-run task</p>
        <h2>Update summary</h2>
      </div>
    </div>
    <dl class="meta-grid meta-grid-three">
      <div class="meta-item">
        <dt>Order ID</dt>
        <dd class="mono"><%= display(shopifyUpdateTask.order_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>Shopify order ID</dt>
        <dd class="mono"><%= display(shopifyUpdateTask.shopify_order_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>Task type</dt>
        <dd class="mono"><%= display(shopifyUpdateTask.task_type) %></dd>
      </div>
      <div class="meta-item">
        <dt>Status</dt>
        <dd><span class="status-badge <%= statusClass(shopifyUpdateTask.status) %>"><%= display(shopifyUpdateTask.status) %></span></dd>
      </div>
      <div class="meta-item">
        <dt>Dry-run</dt>
        <dd><span class="status-badge status-neutral"><%= dryRunLabel(shopifyUpdateTask.dry_run) %></span></dd>
      </div>
      <div class="meta-item">
        <dt>Attempts</dt>
        <dd><%= display(shopifyUpdateTask.attempt_count) %> / <%= display(shopifyUpdateTask.max_attempts) %></dd>
      </div>
      <div class="meta-item">
        <dt>Last error</dt>
        <dd><%= display(shopifyUpdateTask.last_error) %></dd>
      </div>
      <div class="meta-item">
        <dt>Created</dt>
        <dd><%= display(shopifyUpdateTask.created_at) %></dd>
      </div>
    </dl>
  </section>

  <details class="card disclosure">
    <summary>
      <span>
        <span class="section-label">Technical data</span>
        <strong>Redacted dry-run payload</strong>
      </span>
      <span class="disclosure-hint">Show payload</span>
    </summary>
    <pre class="code-panel"><%= payloadJson || '{}' %></pre>
  </details>
</section>
