<% const task = shopifyUpdateTask; const writeBlockReason = task.result_json?.externalWriteBlockedReason || task.result_json?.writeSuppressedReason || task.payload_json?.writeSuppressedReason; %>
<section class="page">
  <header class="page-header">
    <div>
      <a class="back-link" href="/admin/shopify-update-tasks">Back to shopify update tasks</a><p class="eyebrow">Shopify Update Task detail</p><h1>Shopify Update Task #<%= task.id %></h1><p class="page-description"><%= admin.display(task.task_type) %></p>
    </div>
    <span class="status-badge <%= admin.statusClass(task.status) %>"><%= admin.statusLabel(task.status) %></span>
  </header>
  <section class="card">
    <div class="card-header">
      <h2>Executor outcome</h2>
    </div>
    <dl class="meta-grid meta-grid-three">
      <div class="meta-item">
        <dt>Order</dt>
        <dd><% if (task.order_id) { %><a href="/admin/orders/<%= task.order_id %>">#<%= task.order_id %></a><% } else { %>&mdash;<% } %></dd>
      </div>
      <div class="meta-item">
        <dt>Shopify order ID</dt>
        <dd class="mono"><%= admin.display(task.shopify_order_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>Attempts</dt>
        <dd><%= admin.display(task.attempt_count) %></dd>
      </div>
      <div class="meta-item">
        <dt>Maximum attempts</dt>
        <dd><%= admin.display(task.max_attempts) %></dd>
      </div>
      <div class="meta-item">
        <dt>External ID</dt>
        <dd class="mono"><%= admin.display(task.external_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>Execution mode</dt>
        <dd><%= task.dry_run === null || task.dry_run === undefined ? 'Not recorded' : Number(task.dry_run) ? 'Dry-run' : 'Live' %></dd>
      </div>
      <div class="meta-item">
        <dt>External write block</dt>
        <dd class="mono"><%= admin.display(writeBlockReason) %></dd>
      </div>
      <div class="meta-item">
        <dt>Last error</dt>
        <dd><%= admin.display(task.last_error) %></dd>
      </div>
    </dl>
  </section>
  <section class="card">
    <div class="card-header">
      <h2>Timeline</h2>
    </div>
    <dl class="meta-grid meta-grid-three">
      <div class="meta-item">
        <dt>Created</dt>
        <dd><%= admin.date(task.created_at) %></dd>
      </div>
      <div class="meta-item">
        <dt>Processed</dt>
        <dd><%= admin.date(task.processed_at) %></dd>
      </div>
      <div class="meta-item">
        <dt>Completed</dt>
        <dd><%= admin.date(task.completed_at) %></dd>
      </div>
      <div class="meta-item">
        <dt>Skipped</dt>
        <dd><%= admin.date(task.skipped_at) %></dd>
      </div>
      <div class="meta-item">
        <dt>Failed / manual review</dt>
        <dd><%= admin.date(task.failed_at) %></dd>
      </div>
    </dl>
  </section>
  <section class="card">
    <div class="card-header">
      <h2>Task diagnostics</h2>
    </div>
    <dl class="meta-grid meta-grid-three">
      <div class="meta-item">
        <dt>Idempotency key</dt>
        <dd class="mono"><%= admin.display(task.idempotency_key) %></dd>
      </div>
      <div class="meta-item">
        <dt>Source type</dt>
        <dd><%= admin.display(task.source_type) %></dd>
      </div>
      <div class="meta-item">
        <dt>Source ID</dt>
        <dd class="mono"><%= admin.display(task.source_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>Locked by</dt>
        <dd class="mono"><%= admin.display(task.locked_by) %></dd>
      </div>
      <div class="meta-item">
        <dt>Locked at</dt>
        <dd><%= admin.date(task.locked_at) %></dd>
      </div>
    </dl>
  </section>
  <details class="card disclosure">
    <summary><strong>Redacted task payload</strong></summary><pre class="code-panel"><%= admin.json(payloadJson || {}) %></pre>
  </details>
  <details class="card disclosure">
    <summary><strong>Redacted result</strong></summary><pre class="code-panel"><%= admin.json(resultJson || {}) %></pre>
  </details>
</section>
