<section class="dashboard">
  <p class="eyebrow">Admin</p>
  <h1><%= title %></h1>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Order Number</th>
        <th>Shopify Order ID</th>
        <th>Customer</th>
        <th>Financial Status</th>
        <th>Status</th>
        <th>Created At</th>
        <th>Detail</th>
      </tr>
    </thead>
    <tbody>
      <% if (orders.length === 0) { %>
        <tr>
          <td colspan="8">No orders recorded yet.</td>
        </tr>
      <% } %>

      <% orders.forEach((order) => { %>
        <tr>
          <td><%= order.id %></td>
          <td><%= order.shopify_order_number || '' %></td>
          <td><%= order.shopify_order_id || '' %></td>
          <td><%= order.customer_name || '' %></td>
          <td><%= order.financial_status || '' %></td>
          <td><%= order.status %></td>
          <td><%= order.created_at %></td>
          <td><a href="/admin/orders/<%= order.id %>">View</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
