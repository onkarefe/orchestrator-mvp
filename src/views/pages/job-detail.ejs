<section class="page">
  <header class="page-header">
    <div>
      <a class="back-link" href="/admin/jobs">Back to jobs</a><p class="eyebrow">Job detail</p><h1>Job #<%= job.id %></h1><p class="page-description"><%= admin.display(job.product_title) %></p>
    </div>
    <span class="status-badge <%= admin.statusClass(job.status) %>"><%= admin.statusLabel(job.status) %></span>
  </header>
  <section class="card">
    <div class="card-header">
      <h2>Production item</h2>
    </div>
    <dl class="meta-grid meta-grid-three">
      <div class="meta-item">
        <dt>Order</dt>
        <dd><% if (job.order_id) { %><a href="/admin/orders/<%= job.order_id %>">#<%= job.order_id %></a><% } else { %>&mdash;<% } %></dd>
      </div>
      <div class="meta-item">
        <dt>Shopify line item</dt>
        <dd class="mono"><%= admin.display(job.shopify_line_item_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>Variant</dt>
        <dd><%= admin.display(job.variant_title) %></dd>
      </div>
      <div class="meta-item">
        <dt>SKU</dt>
        <dd class="mono"><%= admin.display(job.sku) %></dd>
      </div>
      <div class="meta-item">
        <dt>Width (mm)</dt>
        <dd><%= admin.display(job.width_mm) %></dd>
      </div>
      <div class="meta-item">
        <dt>Height (mm)</dt>
        <dd><%= admin.display(job.height_mm) %></dd>
      </div>
      <div class="meta-item">
        <dt>Attempts</dt>
        <dd><%= admin.display(job.attempt_count) %></dd>
      </div>
      <div class="meta-item">
        <dt>Maximum attempts</dt>
        <dd><%= admin.display(job.max_attempts) %></dd>
      </div>
      <div class="meta-item">
        <dt>Master asset</dt>
        <dd class="mono"><%= admin.display(job.master_asset_id) %></dd>
      </div>
    </dl>
  </section>
  <section class="card">
    <div class="card-header">
      <h2>Factory identity</h2>
    </div>
    <dl class="meta-grid meta-grid-three">
      <div class="meta-item">
        <dt>Factory reference</dt>
        <dd class="mono"><%= admin.display(job.factory_reference) %></dd>
      </div>
      <div class="meta-item">
        <dt>NEXO job ID</dt>
        <dd class="mono"><%= admin.display(job.nexo_job_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>NEXO status</dt>
        <dd><span class="status-badge <%= admin.statusClass(job.nexo_status) %>"><%= admin.statusLabel(job.nexo_status) %></span></dd>
      </div>
    </dl>
  </section>
  <% if (job.last_error || job.manual_review_reason) { %>
  <section class="card">
    <div class="card-header">
      <h2>Requires attention</h2>
    </div>
    <dl class="meta-grid">
      <div class="meta-item">
        <dt>Manual review reason</dt>
        <dd><%= admin.display(job.manual_review_reason) %></dd>
      </div>
      <div class="meta-item">
        <dt>Last error</dt>
        <dd><%= admin.display(job.last_error) %></dd>
      </div>
    </dl>
  </section>
  <% } %>
  <section class="card">
    <div class="card-header">
      <h2>Timeline</h2>
    </div>
    <dl class="meta-grid meta-grid-three">
      <div class="meta-item">
        <dt>Created</dt>
        <dd><%= admin.date(job.created_at) %></dd>
      </div>
      <div class="meta-item">
        <dt>Started</dt>
        <dd><%= admin.date(job.started_at) %></dd>
      </div>
      <div class="meta-item">
        <dt>Completed</dt>
        <dd><%= admin.date(job.completed_at) %></dd>
      </div>
    </dl>
  </section>
  <section class="card">
    <div class="card-header">
      <h2>Factory uploads</h2><span class="muted"><%= factoryUploadTasks.length %> tasks</span>
    </div>
    <% if (!factoryUploadTasks.length) { %><p class="muted">No factory upload task recorded.</p><% } %>
    <% factoryUploadTasks.forEach(task => { %>
    <details class="card disclosure">
      <summary><strong>Task #<%= task.id %></strong> <span class="status-badge <%= admin.statusClass(task.status) %>"><%= admin.statusLabel(task.status) %></span> <span class="muted">Attempts <%= admin.display(task.attempt_count) %> / <%= admin.display(task.max_attempts) %></span></summary>
      <dl class="meta-grid meta-grid-three">
        <div class="meta-item">
          <dt>Artifact</dt>
          <dd><% if (task.artifact_id) { %><a href="/admin/artifacts/<%= task.artifact_id %>">#<%= task.artifact_id %></a><% } else { %>&mdash;<% } %></dd>
        </div>
        <div class="meta-item">
          <dt>Remote directory</dt>
          <dd class="mono"><%= admin.display(task.remote_dir) %></dd>
        </div>
        <div class="meta-item">
          <dt>Uploaded</dt>
          <dd><%= admin.date(task.uploaded_at) %></dd>
        </div>
        <div class="meta-item">
          <dt>Reason / error</dt>
          <dd><%= admin.display(task.suppressed_reason || task.last_error) %></dd>
        </div>
      </dl>
      <details class="card disclosure">
        <summary><strong>FTP progress</strong></summary><pre class="code-panel"><%= admin.json(task.uploaded_files_json || []) %></pre>
      </details>
    </details>
    <% }) %>
  </section>
  <section class="table-card">
    <div class="table-card-header">
      <h2>Artifacts</h2><p class="muted"><%= artifacts.length %> records</p>
    </div>
    <%- include('../partials/artifacts-table', { artifacts }) %>
  </section>
  <details class="card disclosure">
    <summary><strong>Technical diagnostics</strong></summary>
    <div class="disclosure-content">
      <section class="card">
        <div class="card-header">
          <h2>Worker metadata</h2>
        </div>
        <dl class="meta-grid meta-grid-three">
          <div class="meta-item">
            <dt>Locked at</dt>
            <dd><%= admin.date(job.locked_at) %></dd>
          </div>
          <div class="meta-item">
            <dt>Locked by</dt>
            <dd class="mono"><%= admin.display(job.locked_by) %></dd>
          </div>
          <div class="meta-item">
            <dt>Artifact manifest path</dt>
            <dd class="mono"><%= admin.display(job.artifact_manifest_path) %></dd>
          </div>
        </dl>
      </section>
      <%- include('../partials/activity-log', { logs }) %>
      <details class="card disclosure">
        <summary><strong>Redacted job payload</strong></summary><pre class="code-panel"><%= admin.json(rawPayloadJson || {}) %></pre>
      </details>
    </div>
  </details>
</section>
