<% const security = admin.security(order); %>
<section class="page">
  <header class="page-header">
    <div>
      <a class="back-link" href="/admin/orders">Orders</a><p class="eyebrow">Order detail</p><h1><%= order.shopify_order_number || '#' + order.id %></h1><p class="page-description">Internal order #<%= order.id %></p>
    </div>
  </header>
  <section class="card">
    <dl class="summary-strip">
      <div>
        <dt>Production</dt>
        <dd><span class="status-badge <%= admin.statusClass(order.status) %>"><%= admin.statusLabel(order.status) %></span></dd>
      </div>
      <div>
        <dt>Checkout security</dt>
        <dd><span class="status-badge <%= admin.statusClass(security.held ? 'SECURITY_HOLD' : security.result) %>"><%= admin.statusLabel(security.held ? 'SECURITY_HOLD' : security.result) %></span></dd>
      </div>
      <div>
        <dt>Factory / NEXO</dt>
        <dd><span class="status-badge <%= admin.statusClass(orderPackage?.factory_status || order.factory_status) %>"><%= admin.statusLabel(orderPackage?.factory_status || order.factory_status) %></span><span class="cell-meta mono"><%= admin.display(orderPackage?.nexo_order_id || order.factory_order_id) %></span></dd>
      </div>
      <div>
        <dt>Created</dt>
        <dd><%= admin.date(order.created_at) %></dd>
      </div>
    </dl>
  </section>
  <% if (security.held) { %>
  <section class="alert-panel" role="alert">
    <strong>SECURITY_HOLD &mdash; Factory processing is blocked.</strong><p>Automatic recovery cannot release this hold. Inspect the persisted checkout security result below.</p>
  </section>
  <% } %>
  <section class="card">
    <div class="card-header">
      <h2>Anomalies</h2><span class="muted">Persisted production state</span>
    </div>
    <% if (!monitoring.anomalies.length) { %><p class="healthy-note">No production-chain anomaly detected from the current persisted state.</p><% } else { %>
    <div class="anomaly-list">
      <% monitoring.anomalies.forEach(anomaly => { %>
      <div class="notice<%= anomaly.severity === 'critical' ? '' : ' notice-warning' %>">
        <span class="mono"><%= anomaly.code %></span><span class="status-badge <%= admin.statusClass(anomaly.severity) %>"><%= admin.statusLabel(anomaly.severity) %></span> <%= anomaly.message %>
      </div>
      <% }) %>
    </div>
    <% } %>
  </section>
  <section class="card">
    <div class="card-header">
      <h2>Checkout security</h2>
    </div>
    <dl class="meta-grid meta-grid-three">
      <div class="meta-item">
        <dt>Result</dt>
        <dd><span class="status-badge <%= admin.statusClass(security.result) %>"><%= admin.statusLabel(security.result) %></span></dd>
      </div>
      <div class="meta-item">
        <dt>Mode</dt>
        <dd><%= admin.display(security.mode) %></dd>
      </div>
      <div class="meta-item">
        <dt>Detected</dt>
        <dd><%= admin.date(security.detectedAt) %></dd>
      </div>
      <div class="meta-item">
        <dt>Reason</dt>
        <dd class="mono"><%= admin.display(security.reason) %></dd>
      </div>
      <div class="meta-item">
        <dt>Source</dt>
        <dd><%= admin.display(security.sourceName) %></dd>
      </div>
      <div class="meta-item">
        <dt>Proof digest</dt>
        <dd><%= admin.display(security.proofDigest) %></dd>
      </div>
    </dl>
  </section>
  <section class="card">
    <div class="card-header">
      <h2>Production chain</h2><span class="muted">Recorded stage states</span>
    </div>
    <ol class="pipeline">
      <% monitoring.stages.forEach(stage => { %><li><strong><%= stage.name %></strong><span class="status-badge <%= admin.statusClass(stage.status) %>"><%= admin.statusLabel(stage.status) %></span><span class="cell-meta"><%= stage.count %> record<%= stage.count === 1 ? '' : 's' %></span></li><% }) %>
    </ol>
  </section>
  <section class="card">
    <div class="card-header">
      <h2>Order</h2>
    </div>
    <dl class="meta-grid meta-grid-three">
      <div class="meta-item">
        <dt>Shopify order ID</dt>
        <dd class="mono"><%= admin.display(order.shopify_order_id) %></dd>
      </div>
      <div class="meta-item">
        <dt>Financial status</dt>
        <dd><%= admin.display(order.financial_status) %></dd>
      </div>
      <div class="meta-item">
        <dt>Updated</dt>
        <dd><%= admin.date(order.updated_at) %></dd>
      </div>
      <div class="meta-item">
        <dt>Customer</dt>
        <dd><%= admin.display(order.customer_name) %></dd>
      </div>
      <div class="meta-item">
        <dt>Contact</dt>
        <dd><%= admin.display(order.customer_email) %></dd>
      </div>
      <div class="meta-item">
        <dt>Manual review reason</dt>
        <dd><%= admin.display(order.manual_review_reason) %></dd>
      </div>
      <div class="meta-item">
        <dt>Last error</dt>
        <dd><%= admin.display(order.last_error) %></dd>
      </div>
    </dl>
  </section>
  <section class="table-card">
    <div class="table-card-header">
      <h2>Production items</h2><span class="muted">Persisted line-item routing</span>
    </div>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Production items">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Item / SKU</th>
            <th scope="col">Quantity</th>
            <th scope="col">Classification</th>
            <th scope="col">Routing</th>
            <th scope="col">Reason</th>
          </tr>
        </thead>
        <tbody>
          <% lineItems.forEach(lineItem => { %>
          <tr>
            <td><%= admin.display(lineItem.title) %><span class="cell-meta mono"><%= admin.display(lineItem.sku) %></span><span class="cell-meta mono">Line <%= admin.display(lineItem.shopify_line_item_id) %> / Position <%= admin.display(lineItem.source_position) %></span></td>
            <td><%= admin.display(lineItem.quantity) %></td>
            <td><%= admin.display(lineItem.classification) %></td>
            <td><span class="status-badge <%= admin.statusClass(lineItem.routing_state) %>"><%= admin.statusLabel(lineItem.routing_state) %></span></td>
            <td><%= admin.display(lineItem.routing_reason) %></td>
          </tr>
          <% }) %>
          <% if (!lineItems.length) { %>
          <tr>
            <td colspan="5" class="empty-state">No routed line items recorded.</td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
  <section class="table-card">
    <div class="table-card-header">
      <h2>Render jobs</h2><p class="muted"><%= jobs.length %> records</p>
    </div>
    <%- include('../partials/jobs-table', { jobs }) %>
  </section>
  <section class="card">
    <div class="card-header">
      <h2>Factory handoff</h2>
    </div>
    <dl class="meta-grid meta-grid-three">
      <div class="meta-item">
        <dt>Package ID</dt>
        <dd class="mono"><%= admin.display(orderPackage?.id) %></dd>
      </div>
      <div class="meta-item">
        <dt>Package order number</dt>
        <dd><%= admin.display(orderPackage?.order_number) %></dd>
      </div>
      <div class="meta-item">
        <dt>Package status</dt>
        <dd><span class="status-badge <%= admin.statusClass(orderPackage?.status) %>"><%= admin.statusLabel(orderPackage?.status) %></span></dd>
      </div>
      <div class="meta-item">
        <dt>FTP task</dt>
        <dd class="mono"><%= admin.display(uploadTask?.id) %></dd>
      </div>
      <div class="meta-item">
        <dt>FTP status</dt>
        <dd><span class="status-badge <%= admin.statusClass(uploadTask?.status) %>"><%= admin.statusLabel(uploadTask?.status) %></span></dd>
      </div>
      <div class="meta-item">
        <dt>FTP attempts</dt>
        <dd><%= admin.display(uploadTask?.attempt_count) %> / <%= admin.display(uploadTask?.max_attempts) %></dd>
      </div>
      <div class="meta-item">
        <dt>Uploaded</dt>
        <dd><%= admin.date(uploadTask?.uploaded_at) %></dd>
      </div>
      <div class="meta-item">
        <dt>FTP error / suppression</dt>
        <dd><%= admin.display(uploadTask?.last_error || uploadTask?.suppressed_reason) %></dd>
      </div>
    </dl>
  </section>
  <section class="table-card">
    <div class="table-card-header">
      <h2>Factory callbacks</h2><p class="muted"><%= factoryCallbacks.length %> records</p>
    </div>
    <%- include('../partials/factory-callbacks-table', { factoryCallbacks }) %>
  </section>
  <section class="table-card">
    <div class="table-card-header">
      <h2>Shopify fulfillment / update tasks</h2><p class="muted"><%= shopifyUpdateTasks.length %> records</p>
    </div>
    <%- include('../partials/shopify-update-tasks-table', { shopifyUpdateTasks }) %>
  </section>
  <details class="card disclosure">
    <summary><strong>Technical diagnostics</strong><span class="disclosure-hint">Intake, artifacts, locks, and logs</span></summary>
    <div class="disclosure-content">
      <section class="card">
        <div class="card-header">
          <h2>Package diagnostics</h2>
        </div>
        <dl class="meta-grid meta-grid-three">
          <div class="meta-item">
            <dt>Content checksum</dt>
            <dd class="mono"><%= admin.display(orderPackage?.content_checksum) %></dd>
          </div>
          <div class="meta-item">
            <dt>FTP locked</dt>
            <dd><%= admin.date(uploadTask?.locked_at) %></dd>
          </div>
        </dl>
      </section>
      <details class="card disclosure">
        <summary><strong>FTP progress</strong></summary><pre class="code-panel"><%= admin.json(uploadTask?.uploaded_files_json || []) %></pre>
      </details>
      <section class="table-card">
        <div class="table-card-header">
          <h2>Shopify intake webhooks</h2><p class="muted"><%= webhooks.length %> records</p>
        </div>
        <%- include('../partials/webhooks-table', { webhooks }) %>
      </section>
      <section class="table-card">
        <div class="table-card-header">
          <h2>Artifacts</h2><p class="muted"><%= artifacts.length %> records</p>
        </div>
        <%- include('../partials/artifacts-table', { artifacts }) %>
      </section>
      <%- include('../partials/activity-log', { logs }) %>
      <details class="card disclosure">
        <summary><strong>Redacted Shopify payload</strong></summary><pre class="code-panel"><%= admin.json(rawPayloadJson || {}) %></pre>
      </details>
    </div>
  </details>
</section>
