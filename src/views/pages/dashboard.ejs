<section class="page">
  <header class="page-header">
    <div>
      <p class="eyebrow">Overview</p>
      <h1>Production overview</h1>
      <p class="page-description">Review incoming orders, processing jobs, and webhook activity.</p>
    </div>
  </header>

  <div class="stat-grid">
    <a class="stat-card" href="/admin/orders">
      <span class="stat-label">Orders</span>
      <strong class="stat-value">Order inbox</strong>
      <span class="stat-meta">Open production orders</span>
    </a>

    <a class="stat-card" href="/admin/jobs">
      <span class="stat-label">Jobs</span>
      <strong class="stat-value">Processing queue</strong>
      <span class="stat-meta">Inspect job status and output</span>
    </a>

    <a class="stat-card" href="/admin/webhooks">
      <span class="stat-label">Webhooks</span>
      <strong class="stat-value">Technical inbox</strong>
      <span class="stat-meta">Review Shopify events</span>
    </a>

    <a class="stat-card" href="/admin/artifacts">
      <span class="stat-label">Artifacts</span>
      <strong class="stat-value">Generated output</strong>
      <span class="stat-meta">Inspect ZIP manifests and checksums</span>
    </a>

    <a class="stat-card" href="/admin/factory-callbacks">
      <span class="stat-label">Factory</span>
      <strong class="stat-value">Callback log</strong>
      <span class="stat-meta">Review simulated NEXO statuses</span>
    </a>

    <a class="stat-card" href="/admin/shopify-update-tasks">
      <span class="stat-label">Shopify</span>
      <strong class="stat-value">Dry-run tasks</strong>
      <span class="stat-meta">Inspect suppressed updates</span>
    </a>
  </div>

  <section class="card">
    <div class="card-header">
      <div>
        <p class="section-label">Workspace</p>
        <h2>Production flow</h2>
      </div>
    </div>

    <div class="workflow">
      <div class="workflow-step">
        <span class="workflow-index">01</span>
        <div>
          <strong>Receive</strong>
          <p>Shopify orders enter through the webhook inbox.</p>
        </div>
      </div>
      <div class="workflow-step">
        <span class="workflow-index">02</span>
        <div>
          <strong>Process</strong>
          <p>Configurator line items become production jobs.</p>
        </div>
      </div>
      <div class="workflow-step">
        <span class="workflow-index">03</span>
        <div>
          <strong>Deliver</strong>
          <p>Completed jobs expose downloadable ZIP artifacts.</p>
        </div>
      </div>
    </div>
  </section>
</section>
