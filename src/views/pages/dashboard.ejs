<section class="page">
  <header class="page-header">
    <div>
      <p class="eyebrow">Overview</p><h1>Production monitoring</h1><p class="page-description">Current persisted state across the 50 most recent orders. Counts below refer only to this sample.</p>
    </div>
  </header>
  <dl class="metric-grid">
    <div class="metric">
      <dt>Recent orders</dt>
      <dd><%= summary.total %></dd>
    </div>
    <div class="metric">
      <dt>In progress</dt>
      <dd><%= summary.active %></dd>
    </div>
    <div class="metric">
      <dt>Needs attention</dt>
      <dd><%= summary.attention.length %></dd>
    </div>
    <div class="metric">
      <dt>Security holds</dt>
      <dd><%= summary.holds %></dd>
    </div>
  </dl>
  <section class="card">
    <div class="card-header">
      <h2>Needs attention</h2><span class="muted">Within the recent-order sample</span>
    </div>
    <% if (!summary.attention.length) { %><p class="healthy-note">No recorded holds, failures, review reasons, or errors in this sample.</p><% } else { %>
    <div class="anomaly-list">
      <% summary.attention.forEach(order => { %>
      <div>
        <a class="primary-link" href="/admin/orders/<%= order.id %>"><%= order.shopify_order_number || '#' + order.id %></a>
        <span class="status-badge <%= admin.statusClass(order.status) %>"><%= admin.statusLabel(order.status) %></span> <span class="status-badge <%= admin.statusClass(admin.security(order).result) %>"><%= admin.statusLabel(admin.security(order).result) %></span>
        <% if (order.manual_review_reason) { %><span class="status-badge status-warning">Review required</span><% } %>
        <% if (order.last_error) { %><span class="status-badge status-critical">Error recorded</span><% } %>
      </div>
      <% }) %>
    </div>
    <% } %>
  </section>
  <section class="table-card">
    <div class="table-card-header">
      <h2>Recent orders</h2><a href="/admin/orders">View orders</a>
    </div>
    <%- include('../partials/orders-table', { orders: orders.slice(0, 10) }) %>
  </section>
  <section class="card">
    <h2>Diagnostics</h2>
    <div class="diagnostic-links">
      <a href="/admin/jobs">Jobs</a><a href="/admin/webhooks">Webhooks</a><a href="/admin/factory-callbacks">Factory callbacks</a><a href="/admin/artifacts">Artifacts</a><a href="/admin/shopify-update-tasks">Shopify update tasks</a>
    </div>
  </section>
</section>
