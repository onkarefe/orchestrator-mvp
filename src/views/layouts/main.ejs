<%
  const currentTitle = title || 'Wandini Orchestrator';
  const sections = [
    ['Overview', [['Overview', '/admin', currentTitle === 'Wandini Orchestrator'], ['Orders', '/admin/orders', currentTitle === 'Orders' || currentTitle.startsWith('Order #')]]],
    ['Diagnostics', [
      ['Jobs', '/admin/jobs', currentTitle === 'Jobs' || currentTitle.startsWith('Job #')],
      ['Webhooks', '/admin/webhooks', currentTitle === 'Webhook Inbox' || currentTitle.startsWith('Webhook #')],
      ['Factory callbacks', '/admin/factory-callbacks', currentTitle === 'Factory Callbacks' || currentTitle.startsWith('Factory Callback #')],
      ['Artifacts', '/admin/artifacts', currentTitle === 'Artifacts' || currentTitle.startsWith('Artifact #')],
      ['Shopify update tasks', '/admin/shopify-update-tasks', currentTitle === 'Shopify Update Tasks' || currentTitle.startsWith('Shopify Update Task #')],
    ]],
  ];
%>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= currentTitle %> | Wandini Orchestrator</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <a class="brand" href="/admin"><strong>Wandini</strong><span>Orchestrator</span><small>Internal monitoring</small></a>
      <nav class="admin-nav" aria-label="Admin navigation">
        <% sections.forEach(([label, links]) => { %>
          <div class="nav-group"><p class="nav-label"><%= label %></p>
          <% links.forEach(([label, href, active]) => { %>
            <a class="admin-nav-link<%= active ? ' is-active' : '' %>" href="<%= href %>" <%- active ? 'aria-current="page"' : '' %>><%= label %></a>
          <% }) %>
          </div>
        <% }) %>
      </nav>
      <div class="sidebar-footer">
        <small>Read-only monitoring</small>
        <form method="post" action="/admin/logout"><button class="logout-button" type="submit">Log out</button></form>
      </div>
    </aside>
    <div class="admin-main">
      <header class="admin-header"><span>Operations / <%= currentTitle === 'Wandini Orchestrator' ? 'Overview' : currentTitle %></span><span class="muted">Europe/Berlin</span></header>
      <main id="main-content" class="admin-content"><div class="page-container"><%- body %></div></main>
    </div>
  </div>
</body>
</html>
